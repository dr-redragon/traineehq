# Copy to .env. Everything here ships in the browser bundle, so it must all be
# public: never put a Stripe secret, a service-role key or a Resend key here.
# Those are Supabase function secrets — see the README.

VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional -------------------------------------------------------------------
# VITE_APP_NAME=The Register
# Named in the privacy notice and terms as whoever runs this deployment.
# VITE_OPERATOR_NAME=Example Ltd
# VITE_CONTACT_EMAIL=hello@example.org
# Shown on the subscribe button. The real charge is the Stripe price.
# VITE_PRICE_LABEL=£60 a year
# Which sign-in buttons to show, in order: google, apple, nhs.
# VITE_SIGN_IN_PROVIDERS=google,apple,nhs
# Sent to Microsoft as domain_hint for the NHSmail button. Empty to disable.
# VITE_NHS_DOMAIN_HINT=nhs.net

# Store (Capacitor) builds only ----------------------------------------------
# The deployed website. QR codes and invitation links made inside the app must
# point here, not at the app's own internal address.
# VITE_PUBLIC_URL=https://YOUR-SITE
# The custom URL scheme sign-in returns to. Must match Info.plist / AndroidManifest.
# VITE_NATIVE_SCHEME=theregister
# Leave unset. See "Payments" under "App Store and Google Play" in the README.
# VITE_NATIVE_PURCHASES=
